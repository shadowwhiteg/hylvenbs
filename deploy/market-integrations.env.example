# Modelo do /etc/market-integrations.env lido pelo systemd.
# Copie para o servidor, preencha os segredos e proteja o arquivo:
#   sudo install -o www-data -g www-data -m 600 \
#     market-integrations.env.example /etc/market-integrations.env

NODE_ENV=production
PORT=3000

# O app é servido como subpágina do domínio.
NEXT_PUBLIC_BASE_PATH=/market-integrations

# Origem pública fixa. Substitui o Quick Tunnel: os callbacks de OAuth e a
# URL de notificações passam a ser derivados daqui e não mudam mais.
PUBLIC_BASE_URL=https://hylvenbs.xyz

# Com domínio próprio o túnel não é mais necessário.
DISABLE_TUNNEL=1

# SQLite FORA do diretório do deploy, para um git pull ou re-clone nunca
# apagar o banco. Crie o diretório antes do primeiro start:
#   sudo mkdir -p /var/lib/market-integrations
#   sudo chown www-data:www-data /var/lib/market-integrations
DATABASE_URL="file:/var/lib/market-integrations/prod.db"

# --- Mercado Livre ---------------------------------------------------------
ML_APP_ID=
# Também editável em Configurações (salvo em AppSettings + .env).
ML_CLIENT_SECRET=
# Cadastre exatamente esta URL no DevCenter, em URIs de redirect:
ML_REDIRECT_URI=https://hylvenbs.xyz/market-integrations/api/auth/ml/callback

# --- Shopee ----------------------------------------------------------------
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://hylvenbs.xyz/market-integrations/api/auth/shopee/callback

# --- Fonte do catálogo -----------------------------------------------------
DROP_SITE_URL=https://meudropbrasil.com
DROP_EMAIL=
DROP_PASSWORD=

# --- Operação --------------------------------------------------------------
# hylvenbs.xyz já é liberado automaticamente por vir de PUBLIC_BASE_URL.
ALLOWED_HOSTS=
DEFAULT_MARGIN_PERCENT=30
CATALOG_STOCK_PERCENT=100
CRON_SYNC_MINUTES=60

# --- Agente (opcional) -----------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
