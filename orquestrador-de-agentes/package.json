{
  "name": "agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "generate-key": "node --experimental-strip-types scripts/generate-key.ts",
    "create-admin": "node --experimental-strip-types scripts/create-admin.ts",
    "migrate:secrets": "node --experimental-strip-types scripts/migrate-secrets.ts",
    "migrate:flows": "node --experimental-strip-types scripts/migrate-flows.ts",
    "rotate-keys": "node --experimental-strip-types scripts/rotate-keys.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
