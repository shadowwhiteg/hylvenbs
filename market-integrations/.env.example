# Este arquivo cobre o desenvolvimento local. Para o servidor, use
# deploy/market-integrations.env.example (vira /etc/market-integrations.env).

# Prefixo em que o app é servido. Em produção (hylvenbs.xyz) use
# /market-integrations; deixe vazio/ausente em dev para rodar em localhost:3000/.
# NEXT_PUBLIC_BASE_PATH=/market-integrations

# Origem pública fixa. Quando definida, substitui o Quick Tunnel como base dos
# callbacks de OAuth. Em dev, deixe comentado para usar o túnel.
# PUBLIC_BASE_URL=https://hylvenbs.xyz

# Desliga o Quick Tunnel. Em produção com domínio próprio, use 1.
# DISABLE_TUNNEL=1

DATABASE_URL="file:./dev.db"

ML_APP_ID=
# Também editável em Configurações (salvo em AppSettings + .env). Nunca exposto na API GET.
ML_CLIENT_SECRET=
# OAuth: NÃO use localhost/IP privado — o auth ML retorna CloudFront 403.
# Com `npm run dev`/`npm start` o túnel sobe sozinho; veja a URL em Configurações.
# Fallback; em runtime prefere o túnel quando a origem for privada.
ML_REDIRECT_URI=https://SUA-URL.trycloudflare.com/api/auth/ml/callback

# Desabilita o túnel automático (instrumentation). O script `npm run tunnel` continua disponível.
# DISABLE_TUNNEL=1

# Hosts extras permitidos (CSV). 10.131.24.6 e *.trycloudflare.com já estão liberados.
ALLOWED_HOSTS=

DROP_SITE_URL=https://meudropbrasil.com
DROP_EMAIL=
DROP_PASSWORD=

DEFAULT_MARGIN_PERCENT=30
# Percentual do estoque do Meu Drop usado no catálogo (0–100). Também editável em Configurações.
CATALOG_STOCK_PERCENT=100
CRON_SYNC_MINUTES=60

# Ollama (agente) — defaults também em AppSettings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
